  <script type="application/ld+json">
  {{# if isLocalLanding }}
    {{{ page.metaSchema }}}
  {{else}} 
    {
      "@context": "https://schema.org",
      "@type": "GeneralContractor",
      "image": [
        "https://basementremodeling.com/public/images/logo.png"
       ],
      "name": "BasementRemodeling.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1680 East Gude drive",
        "addressLocality": "Rockville",
        "addressRegion": "MD",
        "postalCode": "20850",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 39.09306322316925,
        "longitude": -77.13078518687242
      },
      "url": "https://basementremodeling.com",
      "telephone": "+18772242434",
      
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "opens": "09:00",
          "closes": "23:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Saturday",
            "Sunday"
          ],
          "opens": "09:00",
          "closes": "21:00"
        }]
    }
  {{/if}}
</script>
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5QVGTHB" height="0" width="0"
      style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  {{# if isLocalLanding }}
  {{> header/header.local }}
  {{else}}
  {{> header/header }}
  {{/if}}

  {{!-- {{> modals/spinner/spinner.modal}} --}}

  <main{{# if isGreyMain }} class="greyMain" {{/if}}>
    {{{ body }}}
    </main>

    {{> footer/footer }}
    {{#unless hideStickyButton }} {{> aside/contact-us-button.aside }} {{/unless}}


    {{> modals/we-can-help/we-can-help.modal}}
    {{> modals/contact-us-new/contact-us-new.modal}}
    {{> modals/get-online-quote/get-online-quote.modal}}
    {{> modals/book/book.modal}}
    {{> modals/view-idea/view-idea.modal }}
    {{> modals/save-idea/save-idea.modal }}
    {{> modals/sign-in/sign-in.modal }}
    {{> modals/edit-profile/edit-profile.modal }}
    {{> modals/create-album/create-album.modal }}
    {{> modals/edit-album/edit-album.modal }}
    {{> modals/add-photo/add-photo.modal }}


    <!--        <script
            async defer src="https://connect.facebook.net/en_US/sdk.js#version=v2.2&appId=214466760546212&xfbml=false&autoLogAppEvents=true"></script>
        <script async defer src="https://apis.google.com/js/api:client.js"></script> 
        <script defer src="/public/scripts/layout.min.js"></script>-->
    <script defer src="/public/scripts/init_{{{@root.applicationVersion}}}.min.js"></script>

    <script src="/public/scripts/layout_{{{@root.applicationVersion}}}.min.js"></script>

    {{!-- <div class="scriptToLoadAfterPageIsReady"
      data-scriptsrc="/public/scripts/layout_{{{@root.applicationVersion}}}.min.js"></div> --}}
    {{# each raw_scripts }}
    <div class="scriptToLoadAfterPageIsReady" data-scriptsrc="{{{ this }}}"></div>
    {{/each}}
    {{# each scripts }}
    <div class="scriptToLoadAfterPageIsReady"
      data-scriptsrc="/public/scripts/{{{ this }}}_{{{@root.applicationVersion}}}.min.js"></div>
    {{/each}}

</body>

</html>