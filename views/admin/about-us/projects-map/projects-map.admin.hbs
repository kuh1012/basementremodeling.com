<h3>Projects Map</h3>
<form class="formNode zipZone" action="/admin/settings/zip-codes/add">
    <section class="fieldSection">
        <div class="fieldWrapper">
            <label class="fieldLabel" for="link">Address</label>
            <input class="textField" type="text" id="link" name="link">
        </div>
        <div class="buttonWrapper">
            <button class="createButton" type="button" data-redirect="/admin/settings/" disabled>
                Create
            </button>
        </div>
    </section>
    <section class="fieldSection">
        <div class="fieldWrapper">
            <label class="fieldLabel" for="codes">Completed Year</label>
            <textarea class="textareaField" id="codes" style="height: 200px;" name="codes"></textarea>
        </div>
    </section>
</form>