<section class="pageHeader">
    <div class="wrapper mainWrapper">
        <div class="contentWrapper">
            <h1 class="pageTitle">Reviews</h1>
            <nav class="breadcrumbs">
                <ul class="breadcrumbList" itemscope itemtype="https://schema.org/BreadcrumbList">
                    {{#mylist '[
                    {"name" : "BasementRemodeling.com", "url" : "/", "index" : "1"},
                    {"name" : "About us", "url" : "/about-us/", "index" : "2"},
                    {"name" : "Reviews", "url" : "/about-us/reviews/", "index" : "3"}
                    ]'}}
                    <li class="breadcrumbLinkWrapper" itemprop="itemListElement" itemscope
                        itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="{{{url}}}">
                            <span itemprop="name"class="breadcrumbLink {{#if _last}}breadcrumbActive{{/if}}" >{{{name}}}</span></a>
                        <meta itemprop="position" content="{{{index}}}" />
                    </li>
                    {{/mylist}}
                </ul>
            </nav>
            {{> micro-blocks/social-links/social-links }}
        </div>
    </div>
</section>

<section class="pageContent">
    <div class="wrapper mainWrapper">
        <p class="textBlock">
            Want to know what our previous clients have to say about their basement remodeling and basement finishing experiences with BasementRemodeling.com? Simply click on a logo to read the BasementRemodeling.com reviews on our company profile.
        </p>
        <p class="textBlock">
            As our basement remodeling and basement finishing reviews show, BasementRemodeling.com is the best Maryland basement remodel company to service Washington DC, Maryland and Virginia. This definitely means something to us, and we think it should mean something to you, too! You can also scroll down to read BasementRemodeling.com reviews directly from this page.
        </p>
    </div>
</section>

<section class="pageContent">
    <div class="wrapper">
        <ul class="cardList elementsWrapper" data-page="9">
            {{# each testimonials }}
                <li class="cardWrapper">
                    <a class="cardLink" href="/about-us/reviews/{{{ testimonialLink }}}">
                        {{# if testimonialImage }}
                            <picture>
                                <source srcset="{{{ testimonialImage }}}_120x83.{{#if @root.webp}}webp{{else}}jpg{{/if}},
                                                {{{ testimonialImage }}}_240x166.{{#if @root.webp}}webp{{else}}jpg{{/if}} 2x"
                                        media="(max-width: 479px)" type="image/{{#if @root.webp}}webp{{else}}jpeg{{/if}}">
                                <source srcset="{{{ testimonialImage }}}_228x123.{{#if @root.webp}}webp{{else}}jpg{{/if}},
                                                {{{ testimonialImage }}}_456x246.{{#if @root.webp}}webp{{else}}jpg{{/if}} 2x"
                                        media="(max-width: 767px)" type="image/{{#if @root.webp}}webp{{else}}jpeg{{/if}}">
                                <source srcset="{{{ testimonialImage }}}_236x123.{{#if @root.webp}}webp{{else}}jpg{{/if}},
                                                {{{ testimonialImage }}}_472x246.{{#if @root.webp}}webp{{else}}jpg{{/if}} 2x"
                                        media="(max-width: 999px)" type="image/{{#if @root.webp}}webp{{else}}jpeg{{/if}}">
                                <source srcset="{{{ testimonialImage }}}_314x173.{{#if @root.webp}}webp{{else}}jpg{{/if}},
                                                {{{ testimonialImage }}}_628x346.{{#if @root.webp}}webp{{else}}jpg{{/if}} 2x"
                                        media="(max-width: 1439px)" type="image/{{#if @root.webp}}webp{{else}}jpeg{{/if}}">
                                <source srcset="{{{ testimonialImage }}}_330x173.{{#if @root.webp}}webp{{else}}jpg{{/if}},
                                                {{{ testimonialImage }}}_660x346.{{#if @root.webp}}webp{{else}}jpg{{/if}} 2x"
                                        media="(min-width: 1440px)" type="image/{{#if @root.webp}}webp{{else}}jpeg{{/if}}">
                                <img class="cardImage" alt="Basement of {{{ testimonialAuthor }}}'s review"
                                     src="{{{ testimonialImage }}}_330x173.{{#if @root.webp}}webp{{else}}jpg{{/if}}"
                                     srcset="{{{ testimonialImage }}}_330x173.{{#if @root.webp}}webp{{else}}jpg{{/if}},
                                             {{{ testimonialImage }}}_660x346.{{#if @root.webp}}webp{{else}}jpg{{/if}} 2x">
                            </picture>
                        {{ else }}
                            <div class="cardImage defaultImage">{{{ testimonialAuthor }}}'s testimonial</div>
                        {{/ if }}
                    </a>
                    <div class="cardData">
                        <a class="cardHeader" href="/about-us/reviews/{{{ testimonialLink }}}">
                            {{{ testimonialAuthor }}}
                        </a>
                        <div class="stars" data-rating="{{{ testimonialRating }}}">
                            Stars: {{{ testimonialRating }}}
                        </div>
                        <p class="cardAnnounce" data-rows="6">{{{ testimonialAnnounce }}}</p>
                        <div class="twoColumnsWrapper bottomCardWrapper">
                            <span class="dataDate">{{{ testimonialDate }}}</span>
                            <span class="dataState">{{{ testimonialState }}}</span>
                        </div>
                        <div class="externalLink" style="padding: 10px 0 10px 0">
                            <a href="{{{externalLink}}}">Read Reviews Online</a>
                        </div>
                    </div>
                </li>
            {{/ each }}
        </ul>
        <button class="showMoreButton {{# if testimonialsData.hiddenButton }}hiddenButton{{/if}}"
                data-scroll="1">SHOW MORE</button>
    </div>
</section>

<template class="elementTemplate">
    <li class="cardWrapper">
        <a class="cardLink" href=""></a>
        <div class="cardData">
            <a class="cardHeader" href=""></a>
            <div class="stars" data-rating=""></div>
            <p class="cardAnnounce" data-rows="6"></p>
            <div class="twoColumnsWrapper bottomCardWrapper">
                <span class="dataDate"></span>
                <span class="dataState"></span>
            </div>
            <div class="externalLink" style="padding: 10px 0 10px 0">
                <a href="{{{externalLink}}}">Read Reviews Online</a>
            </div>
        </div>
    </li>
</template>