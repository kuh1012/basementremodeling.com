<section class="pageHeader">
    <div class="wrapper headerWrapper">
        <div class="contentWrapper">
            <p class="pageTitle">In the press</p>
            <nav class="breadcrumbs">
                <ul class="breadcrumbList" itemscope itemtype="https://schema.org/BreadcrumbList">
                    {{#mylist '[
                    {"name" : "BasementRemodeling.com", "url" : "/", "index" : "1"},
                    {"name" : "About us", "url" : "/about-us/", "index" : "2"},
                    {"name" : "In the press", "url" : "/about-us/in-the-press/", "index" : "3"},
                    {"name" : "", "url" : "", "index" : 4}
                    ]'}}
                    <li class="breadcrumbLinkWrapper" itemprop="itemListElement" itemscope
                        itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="{{#unless _last}}{{{url}}}{{/unless}}">
                            <span itemprop="name"class="breadcrumbLink {{#if _last}}breadcrumbActive{{/if}}" >{{#if _last}}{{{ @root.page.pressTitle }}} {{else}}{{{name}}} {{/if}}</span></a>
                        <meta itemprop="position" content="{{{index}}}" />
                    </li>
                    {{/mylist}}
                </ul>
            </nav>
        </div>
    </div>
</section>

<section class="pageContent">
    <div class="wrapper center">
        <div class="twoColumnsWrapper">
            <span class="dataDate">{{{ page.pressDate }}}</span>
            <span class="dataState">{{{ page.pressMagazine }}}</span>
        </div>
        <div class="twoColumnsWrapper pageTitleWrapper">
            <h1 class="innerPageTitle">{{{ page.pressTitle }}}</h1>
        </div>
        <div class="contentTextarea">
            {{{ page.pressText }}}
        </div>
    </div>
</section>

<section class="pageButtons">
    <div class="wrapper center">
        <div class="twoColumnsWrapper">
            <a href="/about-us/in-the-press/" class="backButton">GO BACK</a>
            {{# if isAdmin }}
                <a class="adminEditButton rightPosition" target="_blank"
                   href="/admin/about-us/press/edit/{{{ page.pressID }}}">EDIT ENTRY</a>
            {{/ if }}
            {{# if page.pressSource }}
                <a class="sourceButton" href="{{{ page.pressSource }}}" target="_blank">SEE IN THE SOURCE</a>
            {{/ if }}
        </div>
    </div>
</section>