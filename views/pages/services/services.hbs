                    <div class="row row-cols-5">
                        {{#mylist '[{"service" : "Basement Remodeling"},
                        {"service" : "Basement Finishing"},
                        {"service" : "Egress Windows, Walk-outs"},
                        {"service" : "Basement Waterproofing"},
                        {"service" : "Foundation Services"}]'}}
                        <div class="col ps-1 pe-1">
                            <div class="w-100 d-flex justify-content-center">
                                <img class="serviceCategoryImage whiteBorder"
                                    src="/public/images/home/instagram/instagram_1.jpeg" alt="{{{ service }}}" {{#if
                                    @first}}loading="eager" {{else}} loading="lazy" {{/if}}>
                            </div>
                            <div class="text-center servicesText">{{{ service }}}</div>
                        </div>
                        {{/mylist}}
                    </div>

                </div>
            </nav>
        </div>
    </div>
</section>

