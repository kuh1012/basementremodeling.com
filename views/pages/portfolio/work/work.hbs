<section class="pageHeader">
    <div class="wrapper headerWrapper">
        <div class="contentWrapper">
            <h1 class="pageTitle">Portfolio</h1>
            <nav class="breadcrumbs">
                <ul class="breadcrumbList" itemscope itemtype="https://schema.org/BreadcrumbList">
                     {{#mylist '[
                    {"name" : "BasementRemodeling.com", "url" : "/", "index" : "1"},
                    {"name" : "Portfolio", "url" : "/portfolio", "index" : "2"},
                    {"name" : "", "url" : "", "index" : "3"}
                    ]'}}
                    <li class="breadcrumbLinkWrapper" itemprop="itemListElement" itemscope
                        itemtype="https://schema.org/ListItem">
                        <a itemprop="item" href="{{{url}}}">
                            <span itemprop="name"
                                class="breadcrumbLink {{#if _last}}breadcrumbActive{{/if}}">{{#if _last}}{{{ @root.page.workTitle }}}{{#if @root.page.workCity}}, {{{ @root.page.workCity }}}{{/if}}{{else}}{{{name}}}{{/if}}</span></a>
                        <meta itemprop="position" content="{{{index}}}" />
                    </li>
                    {{/mylist}}

                </ul>
            </nav>
        </div>
    </div>
</section>

<section class="portfolioWork">
    <div class="wrapper slimWrapper">
        <h1 class="sectionTitle">{{{ page.workTitle }}} {{#if page.workCity }}, {{{ page.workCity }}} {{/if}}</h1>
        <div class="headerArrows">
            {{# if page.prevLink }}
                <a href="/portfolio/{{{ page.prevLink }}}"
                   class="headerArrow leftArrow">View previous portfolio work</a>
            {{/ if }}
            {{# if page.nextLink }}
                <a href="/portfolio/{{{ page.nextLink }}}"
                   class="headerArrow rightArrow">View next portfolio work</a>
            {{/ if }}
        </div>
        <div class="squareData">{{{ page.workSquare }}} SQ. FT.</div>
        <div class="picturesWrapper">
            <div class="pictureFull">
                <a class="fullsizePictureLink" data-fslightbox="gallery" href="">
                    <img class="fullsizePicture hiddenPicture" src=""
                         alt="{{{ page.workTitle }}} {{{ page.workCity }}}">
                </a>
                <div class="fullsizeLoader"></div>
            </div>
            <div class="portfolioPreviews">
                <ul class="previewList">
                    {{# each page.images }}
                        <li class="previewWrapper"
                            data-picture="{{{ ideaImage }}}.jpg">
                            <picture>
                                <source srcset="{{{ ideaImage }}}_44x44.jpg,
                                            {{{ ideaImage }}}_88x88.jpg 2x"
                                        media="(max-width: 479px)">
                                <source srcset="{{{ ideaImage }}}_71x71.jpg,
                                            {{{ ideaImage }}}_142x142.jpg 2x"
                                        media="(min-width: 480px)">
                                <img class="previewImage" src="{{{ ideaImage }}}_71x71.jpg"
                                     data-picture="{{{ ideaImage }}}.jpg"
                                     srcset="{{{ ideaImage }}}_71x71.jpg,
                                         {{{ ideaImage }}}_142x142.jpg 2x"
                                     alt="{{{ ideaTitle }}}">
                            </picture>
                            <a class="previewLink"></a>
                        </li>
                    {{/each}}
                </ul>
            </div>
        </div>
        <div class="portfolioText">
            <h4 class="mt-2 mb-2">Project Description:</h4>
            <div class="" style="margin-top:-5px;">
                {{{ page.workText }}}
            </div>
        </div>
        <div class="buttonWrapper">
            <a href="/portfolio/" title="Return to portfolio" class="backButton">GO BACK</a>
            {{# if isAdmin }}
                <a href="/admin/portfolio/edit/{{{ page.portfolioID }}}" title="Edit portfolio entry"
                   class="adminEditButton" target="_blank">EDIT ENTRY</a>
            {{/ if }}
        </div>
    </div>
</section>