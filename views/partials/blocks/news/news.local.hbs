<div id="news" style="position:relative;top:-100px;"></div>
<section class="newsSection homeSection">
    <h2 class="sectionTitle text-center">{{{ page.operationsTitle }}}</h2>
    <div class="myNewsWrapper d-flex flex-column flex-md-row">
        <div class="pictureWrapper d-flex justify-content-center align-items-center">
                <picture class="pictureWrapper ">
                        <source srcset="/public/images/home/landing/ACH_fleet_360.{{#if @root.webp}}webp{{else}}jpg{{/if}}"
                            media="(max-width: 768px)" type="image/{{#if @root.webp}}webp{{else}}jpeg{{/if}}">
                        <source srcset="/public/images/home/landing/ACH_fleet_480.{{#if @root.webp}}webp{{else}}jpg{{/if}}"
                            media="(max-width: 1000px)" type="image/{{#if @root.webp}}webp{{else}}jpeg{{/if}}">
                        <img class="newsImage local " alt="News cover"
                            data-src="/public/images/home/landing/ACH_fleet_480.jpg"
                            loading="lazy">
                    </picture>
        </div>

        <div class="newsWrapper">
            <p class="newsText">{{{ page.operationsText}}}</p>
            <div class="bottonWrapper">
                <div class="socialLinksWrapper">
                    <p class="bottomAnnotation">Follow us on social media</p>
                    <ul class="socialList">
                        <li class="socialLinkWrapper">
                            <a class="socialLink instagramLink" href="{{{ linkInstagram }}}"
                                target="_blank">Instagram</a>
                        </li>
                        <li class="socialLinkWrapper">
                            <a class="socialLink facebookLink" href="{{{ linkFacebook }}}" target="_blank">Facebook</a>
                        </li>
                        <li class="socialLinkWrapper">
                            <a class="socialLink yelpLink"
                                href="https://www.yelp.com/biz/basement-remodeling-rockville-3" target="_blank">Yelp</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>