<section class="ideasSection homeSection">
    <div class="wrapper listWrapper pt-3 pb-3">
        <h2 class="sectionTitle">{{{ page.ideasTitle }}}</h2>
        <div class="textBlock text-start mb-1">{{{ page.ideasText }}}</div>
        {{> micro-blocks/middle-categories/middle-categories.home }}
        <ul class="ideaList">
            {{# each ideas }}
                {{> micro-blocks/idea/idea }}
            {{/each}}
        </ul>
        <a class="ideasButton" href="/basement-ideas/">GO TO BASEMENT IDEAS</a>
    </div>
</section>