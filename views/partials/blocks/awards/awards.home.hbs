<div id="awards" style="position:relative;top:-100px;"></div>
<section class="awardsSection homeSection">
    <div class="wrapper headerWrapper maxPadding">
        <div class="awardsData">
            {{!-- <h2 class="sectionTitle">{{{ content.content10 }}}</h2> --}}
            <h2 class="sentionTitle">Recognitions</h2>
            <p class="textBlock">{{{ content.content11 }}}</p>
        </div>
        <ul class="awardList">
            {{#mylist '[
            {"location" : "/public/images/home/awards/new/Inc_5000", "alt" : "Inc 5000"},
            {"location" : "/public/images/home/awards/new/Qualified_Remodeler", "alt" : "Qualified Remodeler Top 500 Remodelers List"},
            {"location" : "/public/images/home/awards/new/Yelp", "alt" : "People love us on Yelp"},
            {"location" : "/public/images/home/awards/new/Best_Pick_Reports", "alt" : "Best picks 2022 reports award"},
            {"location" : "/public/images/home/awards/new/BBB", "alt" : "BBB Accredited Business"},
            {"location" : "/public/images/home/awards/new/Angi", "alt" : "Angies List 2011-2024 award"},
            {"location" : "/public/images/home/awards/new/Best_Of_Houzz", "alt" : "Houzz 2013-2025 award"},
            {"location" : "/public/images/home/awards/new/EPA", "alt" : "EPA award"},
            ]'}}
            <li class="awardWrapper">
                <picture>
                    <source
                        srcset="{{{location}}}.{{#if @root.webp}}webp{{else}}png{{/if}},
                                        {{{location}}}@2x.{{#if @root.webp}}webp{{else}}png{{/if}} 2x"
                        type="image/{{#if @root.webp}}webp{{else}}png{{/if}}">
                    <img loading="lazy" class="awardImage" alt="{{{alt}}}"
                        src="{{{location}}}.{{#if @root.webp}}webp{{else}}png{{/if}}"
                        srcset="{{{location}}}.{{#if @root.webp}}webp{{else}}png{{/if}},
                                    {{{location}}}@2x.{{#if @root.webp}}webp{{else}}png{{/if}} 2x">
                </picture>
            </li>
            {{/mylist}}

        </ul>
    </div>
</section>